APP_NAME="Salon Surya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# Data salon (dipakai di footer, kontak, dan pesan WhatsApp)
SALON_NAME="${APP_NAME}"
SALON_TAGLINE="Glow up di sini aja!"
SALON_ADDRESS="Jl. Contoh No. 12, Surabaya, Jawa Timur"
SALON_PHONE="031-5551234"
# Nomor WhatsApp salon, format internasional tanpa + dan tanpa 0 di depan
SALON_WHATSAPP=6281234567890
SALON_INSTAGRAM=salon.cantik
SALON_OPEN_TEXT="Setiap hari, 09.00 - 20.00 WIB"
# Kata kunci untuk peta Google Maps (nama tempat + kota lebih akurat daripada alamat saja)
SALON_MAP_QUERY="Salon Cantik, Surabaya"

# Jam operasional untuk booking (24 jam, HH:MM)
SALON_OPEN=09:00
SALON_CLOSE=20:00
SALON_SLOT_MINUTES=30
SALON_MAX_ADVANCE_DAYS=30

# Akun admin awal (dipakai oleh AdminSeeder). WAJIB diganti sebelum produksi.
ADMIN_NAME="Pemilik Salon"
ADMIN_EMAIL=admin@salon.test
ADMIN_PASSWORD=ganti-password-ini

# Akses privat: isi token acak panjang agar hanya pemilik link (?akses=TOKEN) yang bisa membuka situs. Kosongkan untuk publik.
ACCESS_TOKEN=

# Hosting tanpa SSH: simpan unggahan langsung di public/storage (tanpa symlink)
PUBLIC_DISK_IN_PUBLIC=false
